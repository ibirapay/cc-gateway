#!/usr/bin/env python3
"""ccg-panel -- tiny web GUI for CC Gateway OAuth control.

Env: CCG_CLIENT_TOKEN (required, any client token from config.yaml), CCG_GATEWAY,
CCG_BIND (default 127.0.0.1; only loopback or an address on the tailscale0 interface), CCG_PORT (default 9480), CCG_ENV_FILE (default ~/.config/ccg-panel.env,
rewritten when the panel rotates its own token), CCG_ALLOWED_HOSTS (extra host:port names the panel
answers to, comma separated). No login: access control is the tailnet ACL.
Self-check: ccg-panel --selftest
"""
import base64, hashlib, ipaddress, json, os, secrets, subprocess, sys
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.request import Request, urlopen
from urllib.error import HTTPError
from urllib.parse import urlencode, urlparse, parse_qs
from pathlib import Path

GATEWAY = os.environ.get("CCG_GATEWAY", "http://ccg.pagcoin.org:8443")
CLIENT_TOKEN = os.environ.get("CCG_CLIENT_TOKEN", "")
LOCAL_CREDS = Path.home() / ".claude" / ".credentials.json"
BIND = os.environ.get("CCG_BIND", "127.0.0.1")
PORT = int(os.environ.get("CCG_PORT", "9480"))
ENV_FILE = Path(os.environ.get("CCG_ENV_FILE", str(Path.home() / ".config" / "ccg-panel.env")))
ALLOWED_HOSTS = {f"127.0.0.1:{PORT}", f"localhost:{PORT}"} | {
    h.strip().lower() for h in os.environ.get("CCG_ALLOWED_HOSTS", "").split(",") if h.strip()}


def parse_ip_addrs(ip_o_output: str) -> set[str]:
    """Addresses from `ip -o addr show` output."""
    words = ip_o_output.split()
    return {words[i + 1].split("/")[0] for i, w in enumerate(words[:-1]) if w in ("inet", "inet6")}


def bind_allowed(bind: str, tailnet: set[str] | None = None) -> bool:
    """Plain HTTP carries the password and tokens: only loopback, or an address that really sits on the
    WireGuard-encrypted tailscale0 interface (100.64.0.0/10 alone is also carrier NAT, so not proof)."""
    try:
        if bind == "localhost" or ipaddress.ip_address(bind).is_loopback:
            return True
    except ValueError:
        return False
    if tailnet is None:
        try:
            out = subprocess.run(["ip", "-o", "addr", "show", "dev", "tailscale0"],
                                 capture_output=True, text=True, timeout=5).stdout
        except OSError:
            out = ""
        tailnet = parse_ip_addrs(out)
    return bind in tailnet

