CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
SCOPES = "org:create_api_key user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload user:plugins"
# Python-urllib's UA gets Cloudflare 1010; "claude-code/..." gets a fake 429 rate_limit_error
UA = "claude-cli/2.1.304 (external, cli)"

# ponytail: one in-flight login at a time, fine for a single-operator panel
