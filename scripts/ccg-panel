<script>
async function loadStatus() {
  try {
    const d = await (await fetch('/api/health')).json();
    const ok = d.oauth === 'valid';
    document.getElementById('dot').style.background = ok ? 'var(--green)' : 'var(--red)';
    setText('s-status', d.status || 'error', ok ? 'ok' : 'bad');
    setText('s-oauth', d.oauth || '-', ok ? 'ok' : 'bad');
    setText('s-upstream', d.upstream || '-', '');
    document.getElementById('s-clients').innerHTML =
      (d.clients||[]).map(c => '<span class="chip" title="Rotate token" onclick="openClient(this.textContent)">'+esc(c)+'</span>').join('');
  } catch(e) {
    document.getElementById('dot').style.background = 'var(--red)';
    setText('s-status', 'unreachable', 'bad');
    setText('s-oauth', '-', 'muted');
    setText('s-upstream', '-', 'muted');
    document.getElementById('s-clients').innerHTML = '';
  }
}

let _launcher = null, _client = null;

function openClient(name) {
  _client = name;
  document.getElementById('a-name').textContent = name;
  document.getElementById('rotate-result').style.display = 'none';
  document.getElementById('client-actions').style.display = 'block';
}

async function rotate(grace) {
  const name = _client;
  if (grace && !confirm('Rotate the token for ' + name + '?\\n\\nThe old token keeps working for 24 hours, then stops. ' +
               'Rotating the same client again within 24 hours cuts off its oldest token immediately.')) return;
  if (!grace && !confirm('Kill every old token of ' + name + ' right now?\\n\\n' + name +
               "'s machine stops working until the new launcher is installed.")) return;
  try {
    const d = await post('/api/rotate', {name, grace});
    if (d.status !== 'ok') { showMsg(d.error || JSON.stringify(d), 'err'); return; }
    _launcher = d.launcher;
    document.getElementById('client-actions').style.display = 'none';
    document.getElementById('r-name').textContent = d.name;
    document.getElementById('r-token').value = d.token;
    document.getElementById('r-grace').textContent =
      (d.previous_valid_until ? 'Old token works until ' + new Date(d.previous_valid_until).toLocaleString() + '. '
                              : 'Old token was invalidated now. ') +
      (d.launcher ? 'Install the new launcher on ' + d.name + "'s machine before then (run it with: install)."
                  : 'No launcher on the server: send the token to ' + d.name + ' manually.') +
      (d.self ? " This was the panel's own token: it already switched to the new one." : '');
    document.getElementById('r-download').style.display = d.launcher ? '' : 'none';
    document.getElementById('rotate-result').style.display = 'block';
    showMsg('Rotated ' + d.name + '.', 'ok');
  } catch(e) { showMsg(friendlyErr(e), 'err'); }
}
async function endGrace() {
  const name = _client;
  if (!confirm('Kill the old token of ' + name + ' now, without waiting for the 24h grace period?')) return;
  try {
    const d = await post('/api/end-grace', {name});
    if (d.status !== 'ok') { showMsg(d.error || JSON.stringify(d), 'err'); return; }
    document.getElementById('client-actions').style.display = 'none';
    showMsg('Old token of ' + name + ' invalidated. Only the newest token works now.', 'ok');
  } catch(e) { showMsg(friendlyErr(e), 'err'); }
}
function copyToken() {
  const el = document.getElementById('r-token');
  el.select();
  document.execCommand('copy');
}
function downloadLauncher() {
  if (!_launcher) return;
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([_launcher.content], {type: 'text/x-shellscript'}));
  a.download = _launcher.filename;
  a.click();
  URL.revokeObjectURL(a.href);
}

async function startLogin() {
  const btn = document.getElementById('btn-login');
  btn.disabled = true;
  try {
    const d = await (await fetch('/api/login-start')).json();
    window.open(d.auth_url, '_blank');
    document.getElementById('login-step2').style.display = 'block';
    document.getElementById('code-input').value = '';
    document.getElementById('code-input').focus();
    showMsg('Authenticate in the new tab, then paste the code here.', 'info');
  } catch(e) { showMsg(friendlyErr(e), 'err'); }
  finally { btn.disabled = false; }
}

async function finishLogin() {
  const code = document.getElementById('code-input').value.trim();
  if (!code) { showMsg('Paste the code first.', 'err'); return; }
  const btn = document.getElementById('btn-finish');
  btn.disabled = true;
  try {
    const d = await post('/api/login-finish', {code});
    if (d.status === 'ok') {
      showMsg('Logged in and swapped! Expires in ' + d.expires_in_minutes + ' min', 'ok');
      document.getElementById('login-step2').style.display = 'none';
      loadStatus();
    } else showMsg(d.error || JSON.stringify(d), 'err');
  } catch(e) { showMsg(friendlyErr(e), 'err'); }
  finally { btn.disabled = false; }
}

async function doSwap() {
  const token = document.getElementById('token-input').value.trim();
  if (!token) { showMsg('Paste a refresh token first.', 'err'); return; }
  await swap(token);
}

async function doSwapLocal() {
  try {
    const d = await (await fetch('/api/local-token')).json();
    if (!d.token) { showMsg('No credentials file on this server. Use Login with Claude.', 'err'); return; }
    await swap(d.token);
  } catch(e) { showMsg(friendlyErr(e), 'err'); }
}

async function swap(token) {
  try {
    const d = await post('/api/swap', {refresh_token: token});
    if (d.status === 'ok') { showMsg('Swapped! Expires in ' + d.expires_in_minutes + ' min', 'ok'); loadStatus(); }
    else showMsg(d.error || d.detail || JSON.stringify(d), 'err');
  } catch(e) { showMsg(friendlyErr(e), 'err'); }
}

async function post(url, body) {
  const r = await fetch(url, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)});
  return r.json();
}
function showMsg(text, type) {
  const el = document.getElementById('msg');
  el.textContent = text;
  el.className = 'msg ' + type;
}
function setText(id, text, cls) {
  const el = document.getElementById(id);
  el.textContent = text;
  el.className = 'val' + (cls ? ' '+cls : '');
}
function friendlyErr(e) {
  if (e.message && e.message.includes('NetworkError')) return 'Panel backend unreachable. Is ccg-panel running?';
  return 'Failed: ' + e.message;
}
function esc(s) { const d=document.createElement('div'); d.textContent=s; return d.innerHTML; }

loadStatus();
setInterval(loadStatus, 30000);
fetch('/api/local-token').then(r => r.json()).then(d => {
  if (!d.token) document.getElementById('btn-local').style.display = 'none';
}).catch(() => {});
</script>
</body>
</html>"""


def b64url(raw: bytes) -> str:
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")


def login_start() -> str:
    global _pkce
    verifier = b64url(secrets.token_bytes(32))
    state = b64url(secrets.token_bytes(32))
    _pkce = {"verifier": verifier, "state": state}
    params = {
        "code": "true",
        "client_id": CLIENT_ID,
        "response_type": "code",
        "redirect_uri": REDIRECT_URI,
        "scope": SCOPES,
        "code_challenge": b64url(hashlib.sha256(verifier.encode("ascii")).digest()),
        "code_challenge_method": "S256",
        "state": state,
    }
    return f"{AUTHORIZE_URL}?{urlencode(params)}"


def parse_pasted_code(text: str) -> tuple[str, str | None]:
    """Claude's callback page shows `code#state`; also accept a full callback URL."""
    text = text.strip()
    if "code=" in text:
        q = parse_qs(urlparse(text).query)
        return q.get("code", [""])[0], q.get("state", [None])[0]
    code, _, state = text.partition("#")
    return code, state or None


def exchange_code(code: str, verifier: str, state: str) -> dict:
    body = json.dumps({
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": REDIRECT_URI,
        "client_id": CLIENT_ID,
        "code_verifier": verifier,
        "state": state,
    }).encode()
    req = Request(TOKEN_URL, data=body, method="POST")
    req.add_header("Content-Type", "application/json")
    req.add_header("User-Agent", UA)
    return json.loads(urlopen(req, timeout=30).read())


def gateway_swap(refresh_token: str) -> tuple[int, dict]:
    return gateway_post("/_oauth", {"refresh_token": refresh_token})


def gateway_rotate(name: str, grace: bool) -> tuple[int, dict]:
    global CLIENT_TOKEN
    code, data = gateway_post("/_admin/rotate", {"name": name, "grace": grace})
    if code == 200 and data.get("self"):
        CLIENT_TOKEN = data["token"]
        if ENV_FILE.exists():
            ENV_FILE.write_text(f"CCG_CLIENT_TOKEN={CLIENT_TOKEN}\n")
    return code, data


def gateway_post(path: str, payload: dict) -> tuple[int, dict]:
    req = Request(f"{GATEWAY}{path}", data=json.dumps(payload).encode(), method="POST")
    req.add_header("x-api-key", CLIENT_TOKEN)
    req.add_header("Content-Type", "application/json")
    try:
        return 200, json.loads(urlopen(req, timeout=30).read())
    except HTTPError as e:
        return e.code, json.loads(e.read() or b"{}")


def request_problem(method: str, headers) -> tuple[int, str] | None:
    """Why a request must be refused, or None. Guards against websites in the operator's own browser:
    the Host allow-list stops DNS rebinding, JSON-only + same Origin stops cross-site POSTs."""
    host = (headers.get("Host") or "").lower()
    if host not in ALLOWED_HOSTS:
        return 403, f"Host {host!r} not allowed (add it to CCG_ALLOWED_HOSTS)"
    if method == "POST":
        if not (headers.get("Content-Type") or "").startswith("application/json"):
            return 415, "JSON requests only"
        origin = headers.get("Origin")
        if origin is not None and origin.lower() != f"http://{host}":
            return 403, "Cross-site request refused"
    return None


class Handler(BaseHTTPRequestHandler):
    def _refused(self, method: str) -> bool:
        problem = request_problem(method, self.headers)
        if not problem:
            return False
        code, msg = problem
        body = json.dumps({"error": msg}).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
        return True

    def do_GET(self):
        if self._refused("GET"):
            return
        if self.path == "/":
            self._send(200, HTML.encode(), "text/html; charset=utf-8")
        elif self.path == "/api/health":
            try:
                self._json(200, json.loads(urlopen(Request(f"{GATEWAY}/_health"), timeout=5).read()))
            except HTTPError as e:
                self._json(e.code, json.loads(e.read() or b"{}"))
            except Exception as e:
                self._json(502, {"error": str(e)})
        elif self.path == "/api/local-token":
            self._json(200, {"token": get_local_refresh_token()})
        elif self.path == "/api/login-start":
            self._json(200, {"auth_url": login_start()})
        else:
            self._json(404, {"error": "not found"})

    def do_POST(self):
        if self._refused("POST"):
            return
        length = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError:
            self._json(400, {"error": "invalid JSON"})
            return
        if self.path == "/api/swap":
            self._json(*gateway_swap(body.get("refresh_token", "")))
        elif self.path == "/api/rotate":
            self._json(*gateway_rotate(body.get("name", ""), body.get("grace") is not False))
        elif self.path == "/api/end-grace":
            self._json(*gateway_post("/_admin/end-grace", {"name": body.get("name", "")}))
        elif self.path == "/api/login-finish":
            self._login_finish(body.get("code", ""))
        else:
            self._json(404, {"error": "not found"})

    def _login_finish(self, pasted: str):
        global _pkce
        if not _pkce:
            self._json(400, {"error": "No login in progress. Click Login with Claude first."})
            return
        code, state = parse_pasted_code(pasted)
        if not code:
            self._json(400, {"error": "Could not find a code in what you pasted."})
            return
        if state and state != _pkce["state"]:
            self._json(400, {"error": "State mismatch: this code is from an older login. Click Login with Claude again."})
            return
        try:
            tokens = exchange_code(code, _pkce["verifier"], _pkce["state"])
        except HTTPError as e:
            self._json(502, {"error": f"Code rejected by Claude ({e.code}): {e.read().decode()[:200]}. If it says invalid_grant, click Login with Claude again."})
            return
        except Exception as e:
            self._json(502, {"error": f"Token exchange failed: {e}"})
            return
        if not tokens.get("refresh_token"):
            self._json(502, {"error": "No refresh_token in Claude's response"})
            return
        _pkce = None
        self._json(*gateway_swap(tokens["refresh_token"]))

    def _json(self, code, data):
        self._send(code, json.dumps(data).encode(), "application/json")

    def _send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        pass


def get_local_refresh_token():
    try:
        rt = json.loads(LOCAL_CREDS.read_text()).get("claudeAiOauth", {}).get("refreshToken", "")
        return rt if rt.startswith("sk-ant-ort01-") else None
    except Exception:
        return None


def selftest():
    assert parse_pasted_code("abc#xyz") == ("abc", "xyz")
    assert parse_pasted_code("  abc  ") == ("abc", None)
    assert parse_pasted_code("https://platform.claude.com/oauth/code/callback?code=abc&state=xyz") == ("abc", "xyz")
    url = login_start()
    q = parse_qs(urlparse(url).query)
    assert url.startswith(AUTHORIZE_URL) and len(q["state"][0]) == 43 and len(_pkce["verifier"]) == 43
    assert q["code_challenge"][0] == b64url(hashlib.sha256(_pkce["verifier"].encode()).digest())
    import shutil, subprocess, tempfile
    if shutil.which("node"):
        js = HTML.split("<script>")[1].split("</script>")[0]
        with tempfile.NamedTemporaryFile("w", suffix=".js") as f:
            f.write(js)
            f.flush()
            r = subprocess.run(["node", "--check", f.name], capture_output=True, text=True)
        assert r.returncode == 0, "panel JS does not parse:\n" + r.stderr
    ok = {"Host": f"127.0.0.1:{PORT}"}
    assert request_problem("GET", ok) is None
    assert request_problem("GET", {**ok, "Host": "evil.example:9480"})[0] == 403, "DNS rebinding"
    assert request_problem("POST", {**ok, "Content-Type": "text/plain"})[0] == 415, "simple cross-site POST"
    js = {**ok, "Content-Type": "application/json"}
    assert request_problem("POST", {**js, "Origin": "http://evil.example"})[0] == 403, "foreign Origin"
    assert request_problem("POST", {**js, "Origin": f"http://127.0.0.1:{PORT}"}) is None
    ts = parse_ip_addrs("6: tailscale0    inet 100.64.0.10/32 scope global tailscale0\\       valid_lft forever\n"
                        "6: tailscale0    inet6 fd7a:115c:a1e0::a/128 scope global \\       valid_lft forever\n")
    assert ts == {"100.64.0.10", "fd7a:115c:a1e0::a"}, ts
    assert bind_allowed("127.0.0.1", ts) and bind_allowed("localhost", ts) and bind_allowed("100.64.0.10", ts)
    assert not bind_allowed("100.64.0.99", ts), "CGNAT address not on tailscale0"
    assert not bind_allowed("0.0.0.0", ts) and not bind_allowed("172.93.109.133", ts)
    print("selftest ok")


def main():
    if sys.argv[1:] == ["--selftest"]:
        selftest()
        return
    if not CLIENT_TOKEN:
        sys.exit("CCG_CLIENT_TOKEN is not set (use any client token from the gateway's config.yaml)")
    if not bind_allowed(BIND):
        sys.exit(f"Refusing to listen on {BIND}: plain HTTP is only safe on loopback or the tailscale0 interface")
    server = HTTPServer((BIND, PORT), Handler)
    url = f"http://{BIND}:{PORT}"
    print(f"CCG Panel: {url}")
    if BIND == "127.0.0.1" and sys.stdout.isatty():
        import webbrowser
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
    main()
